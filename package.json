{
  "name": "mact-compensation-estimator",
  "version": "0.1.0",
  "private": true,
  "description": "Open, citation-backed estimator of motor accident (MACT, s.166 MV Act) compensation in India: legal entitlement on your facts, offer check and case journeys.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mact": "tsx src/cli/mact.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:validate": "tsx src/cli/mact.ts rules validate",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run rules:validate"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
